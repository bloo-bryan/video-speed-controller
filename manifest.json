{
    "manifest_version": 3,
    "name": "Video Playback Speed Controller",
    "version": "1.1", // Incremented version number
    "description": "Adjust the playback speed of HTML5 videos on any page using popup controls or 's'/'d' keys.",
    "permissions": [
      "activeTab", // Still needed for popup interaction if used
      "scripting", // Still needed for popup to execute functions in content script
      "storage"    // Needed for saving/loading speed
      // Note: We don't explicitly need "tabs" or host permissions like "<all_urls>" here
      // because the content_scripts "matches" implicitly requests permission for those URLs.
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"], // Inject into all http and https pages
        "js": ["content.js"],    // The script to inject
        "run_at": "document_idle", // Run after DOM is complete, usually best for finding elements
        "all_frames": true        // Inject into all frames (including iframes like embedded players)
      }
    ]
  }